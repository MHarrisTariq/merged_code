## Services
SEO_SERVICE_PORT=5001
AI_SERVICE_PORT=5002
PRICING_SERVICE_PORT=5003
PREDICTION_SERVICE_PORT=5004
ANALYTICS_SERVICE_PORT=5005

## Gateway rate limits
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30

## Security (Phase-1 production hardening)
# Used to protect write/admin endpoints like pricing ingest and analytics track.
ADMIN_API_KEY=
# Used for service-to-service auth between gateway and internal services.
INTERNAL_SERVICE_TOKEN=

## AI (optional)
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

## AI uniqueness enforcement (Phase-1 SEO safety)
AI_RECENT_POOL_SIZE=250
AI_MIN_UNIQUENESS=0.35
AI_MAX_REGENERATIONS=3
AI_SERVICE_TIMEOUT_MS=5000

## Frontend
API_URL=http://localhost:5000

