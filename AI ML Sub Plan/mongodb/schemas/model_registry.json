{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "model_registry",
  "description": "Mirror of MLflow model metadata for operational queries (optional cache)",
  "type": "object",
  "required": ["_id", "model_name", "stage", "version", "artifact_uri", "created_at"],
  "properties": {
    "_id": { "type": "string" },
    "model_name": { "type": "string", "enum": ["ctr", "conversion", "propensity_position", "anomaly", "personalization"] },
    "stage": { "type": "string", "enum": ["None", "Staging", "Production", "Archived"] },
    "version": { "type": "integer", "minimum": 1 },
    "artifact_uri": { "type": "string" },
    "run_id": { "type": "string" },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
