{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "subscriptions",
  "description": "Host subscription to a promotion plan (deterministic layer)",
  "type": "object",
  "required": ["_id", "host_id", "plan_id", "status", "started_at"],
  "properties": {
    "_id": { "type": "string", "description": "ObjectId as string" },
    "host_id": { "type": "string" },
    "plan_id": { "type": "string", "enum": ["FREE", "SILVER", "PLATINUM"] },
    "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "CANCELLED", "PENDING"] },
    "started_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "max_promoted_listings": { "type": "integer", "minimum": 0 },
    "auto_allocation_enabled": { "type": "boolean", "default": false },
    "metadata": { "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
