{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prediction_feedback",
  "description": "Doc §14 — predicted vs actual CTR/CVR for drift, retraining, and governance",
  "type": "object",
  "required": ["_id", "listing_id", "model_name", "model_version", "predicted_ctr", "predicted_cvr", "observed_at"],
  "properties": {
    "_id": { "type": "string" },
    "listing_id": { "type": "string" },
    "query_id": { "type": "string" },
    "model_name": { "type": "string" },
    "model_version": { "type": "string" },
    "predicted_ctr": { "type": "number" },
    "predicted_cvr": { "type": "number" },
    "actual_ctr_window": { "type": ["number", "null"] },
    "actual_cvr_window": { "type": ["number", "null"] },
    "drift_score": { "type": ["number", "null"] },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
